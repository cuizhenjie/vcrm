# ---- 数据库（SQLite，零配置）----
DATABASE_URL="file:./dev.db"

# ---- 短信通道：mock(本地无凭证可跑) | lianlu(联麓) | volcengine(火山引擎) ----
SMS_PROVIDER="mock"

# ---- 火山引擎短信（SMS_PROVIDER=volcengine 时必填）----
# 火山引擎 AK/SK（控制台「访问控制」创建，需短信服务权限）；SmsAccount 为短信子账号 ID（GetSubAccountList 的 subAccountId）
SMS_VOLC_ACCESS_KEY=""
SMS_VOLC_SECRET_KEY=""
SMS_VOLC_SMS_ACCOUNT=""
# 短信签名（不带【】，如：北京三酷科技；需在火山控制台审核通过）
SMS_VOLC_SIGN=""
# 内容透传模板 ID：vcrm 是自由文本发送模型，火山必须走预审核模板，
# 需在火山控制台申请一个「正文仅含 {1} 占位」的内容模板，把整条正文作为 {1} 传入
SMS_VOLC_TEMPLATE_ID=""
# 视频短信独立模板（可选，未配则 sendMms 降级）
# SMS_VOLC_MMS_TEMPLATE_ID=""
# 回执/上行回调签名密钥（生产强制：SMS_PROVIDER=volcengine 时必须配置，防止伪造回调触发退款/退订）
SMS_VOLC_WEBHOOK_SECRET=""
# 可选覆盖：超时毫秒（默认 10000）
# SMS_VOLC_TIMEOUT_MS="10000"


# ---- AI 视频生成（火山方舟 Seedance）----
# 火山方舟 API Key（ark.volcengine.com 控制台创建），Bearer 鉴权
ARK_API_KEY=""
ARK_BASE_URL="https://ark.cn-beijing.volces.com"
# 模型：2.0 已 GA / 2.5 上线后替换
ARK_VIDEO_MODEL="doubao-seedance-2-0-260128"
# 视频转存：方舟 URL 24h 失效，配置后转存到自有存储/CDN（留空则提示用户及时下载）
# 模式 1：S3 兼容（AWS S3 / 阿里云 OSS / 腾讯云 COS / MinIO）——真实下载+上传
# VIDEO_S3_ENDPOINT="https://s3.amazonaws.com"
# VIDEO_S3_BUCKET="my-videos"
# VIDEO_S3_KEY="AKIAXXX"
# VIDEO_S3_SECRET="secretXXX"
# VIDEO_S3_REGION="us-east-1"
# VIDEO_S3_PUBLIC_URL="https://cdn.example.com"   # 上传后的公开访问域名（CDN）
#
# 模式 2：简单 CDN 拼接（不实际下载，适用 CDN 回源）
# VIDEO_STORAGE_BASE_URL="https://cdn.example.com/videos"

# ---- 联麓凭证（SMS_PROVIDER=lianlu 时必填，按官方 Signature 文档命名）----
LIANLU_BASE_URL="https://apis.shlianlu.com"
LIANLU_MCH_ID=""
LIANLU_APP_ID=""
LIANLU_API_KEY=""
LIANLU_SIGN_NAME="【你的短信签名】"
LIANLU_VERSION="1.2.0"
LIANLU_MESSAGE_TYPE="1"

# ---- 本站地址（生成短链/回调用）----
APP_BASE_URL="http://localhost:3000"

# ---- 发送限速（条/秒），按通道并发能力调整 ----
SEND_RATE_PER_SEC="20"

# ---- 默认租户（单租户兼容模式；正式 SaaS 后由登录 session 决定）----
DEFAULT_TENANT_ID="default_tenant"
DEFAULT_ACTOR="运营"

# ---- 发送合规与补偿策略 ----
FREQUENCY_DAYS="1"
REFUND_UNDELIVERED="false"

# ---- 通知与预警 ----
# 余额低于此条数时触发预警通知（cron 扫描）
LOW_BALANCE_THRESHOLD="200"
# 订阅到期宽限期（天），超期未续费 → canceled
SUBSCRIPTION_GRACE_DAYS="7"
# SMTP 邮件（可选；不配则仅站内通知）
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""

# ---- 频控 Redis（可选；不配则回退 DB 计数，规模化建议配 Redis）----
# REDIS_URL="redis://localhost:6379"

# ---- ROI 成本模型：每条短信单价（元/条，非法/负值回退 0.05；可设 0 表示免费通道）----
SMS_UNIT_COST="0.05"

# ---- 避扰时段（24h，跨午夜自动处理；默认 22:00-08:00 不发）----
QUIET_START="22"
QUIET_END="8"
# 避扰时段时区：默认 Asia/Shanghai，部署到 UTC 容器(Vercel)时必须显式指定，否则错位
QUIET_TZ="Asia/Shanghai"

# ---- 短链开放重定向防护：允许跳转的目标域名白名单（逗号分隔）----
# 不配则仅允许跳到 APP_BASE_URL 同域名
REDIRECT_ALLOWED_HOSTS=""

# ---- 定时任务触发密钥（外部 cron 调 /api/cron/tick 时校验；生产环境 instrumentation 会强制要求配置）----
CRON_SECRET=""

# ---- 联麓 Webhook 签名密钥（delivery/mo 回调校验；生产环境 instrumentation 会强制要求配置）----
# 联麓控制台配置回调后下发的签名密钥；与联麓约定 HMAC-SHA256 over raw body，签名放 X-Lianlu-Signature 头
LIANLU_WEBHOOK_SECRET=""

# ---- 联麓端点/响应字段（默认值已按联麓官方文档配置，通常无需修改）----
# 文档：https://www.shlianlu.com/console/document/api_4_2
LIANLU_SEND_PATH="/sms/trade/normal/send"
LIANLU_BALANCE_PATH="/sms/trade/balance"
# 视频彩信：联麓独立产品模块，路径需登录控制台文档确认后配 LIANLU_MMS_PATH
LIANLU_MMS_PATH=""
# 以下路径联麓文档未公开，留空则对应功能自动降级（不调用）
LIANLU_FLASH_PATH=""
LIANLU_CHECK_PATH=""
LIANLU_QUERY_PATH=""
# 成功判定：联麓返回 status=="00" 表示成功
LIANLU_SUCCESS_FIELD="status"
LIANLU_SUCCESS_VALUE="00"
# 通道流水号字段：联麓返回 taskId 作为发送流水号，回执按它关联
LIANLU_MESSAGE_ID_FIELD="taskId"
LIANLU_BALANCE_FIELD="balance"
LIANLU_TIMEOUT_MS="10000"

# ---- 联麓回执回调字段（默认按联麓 taskId 流水号关联，按真实回执结构调整）----
LIANLU_DELIVERY_REPORTS_FIELD="reports"
LIANLU_DELIVERY_MESSAGE_ID_FIELD="taskId"
LIANLU_DELIVERY_EXTNO_FIELD="extno"
LIANLU_DELIVERY_MOBILE_FIELD="mobile"
LIANLU_DELIVERY_STATUS_FIELD="status"

# ---- A/B 自动放量：每个变体测试阶段最小样本量（达不到不判显著）----
AB_MIN_SAMPLE="30"

# ---- 登录认证 ----
# 多租户模式下登录走 AppUser 表（注册创建）；兼容模式：无 AppUser 时用 APP_PASSWORD 登录 default_tenant
APP_PASSWORD="admin"
AUTH_SECRET="change-me-to-a-long-random-string"
# 注册功能开关：false 暂停新租户注册（可设 true 默认开启）
REGISTER_ENABLED="true"
# 新租户注册赠送的初始短信额度（条）
REGISTER_SEED_GRANT="1000"
# seed 脚本创建默认管理员(admin@vcrm.local)的初始密码，生产请改
SEED_ADMIN_PASSWORD="admin"

# ---- 支付/充值（短信额度购买）----
# 支付渠道：mock(本地联调) | wechat | alipay
PAYMENT_PROVIDER="mock"
# 微信支付 V3 Native（扫码）凭证——见 src/lib/payment/wechat.ts
PAYMENT_WECHAT_APP_ID=""
PAYMENT_WECHAT_MCH_ID=""
PAYMENT_WECHAT_API_V3_KEY=""
PAYMENT_WECHAT_PRIVATE_KEY=""
PAYMENT_WECHAT_CERT_SERIAL=""
PAYMENT_WECHAT_PLATFORM_CERT=""
# 私钥/平台证书也可用文件路径（优先于上面的内联 PEM）：
# PAYMENT_WECHAT_PRIVATE_KEY_PATH="/path/to/apiclient_key.pem"
# PAYMENT_WECHAT_PLATFORM_CERT_PATH="/path/to/wechatpay_platform_cert.pem"
# 新版微信商户「微信支付公钥」模式（商户平台-API安全 下载），与平台证书同用于验签回调：
# PAYMENT_WECHAT_PLATFORM_PUBLIC_KEY=""
# 支付宝电脑网站支付凭证——见 src/lib/alipay-sdk.ts
PAYMENT_ALIPAY_APP_ID=""
PAYMENT_ALIPAY_PRIVATE_KEY=""
PAYMENT_ALIPAY_PUBLIC_KEY=""
PAYMENT_ALIPAY_GATEWAY="https://openapi.alipay.com/gateway.do"
