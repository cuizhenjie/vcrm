# ---- 数据库（SQLite，零配置）----
DATABASE_URL="file:./dev.db"

# ---- 短信通道：mock(本地无凭证可跑) | lianlu(真实短信通道) ----
SMS_PROVIDER="mock"

# ---- 联麓凭证（SMS_PROVIDER=lianlu 时必填，按官方 Signature 文档命名）----
LIANLU_BASE_URL="https://apis.shlianlu.com"
LIANLU_MCH_ID=""
LIANLU_APP_ID=""
LIANLU_API_KEY=""
LIANLU_SIGN_NAME="【你的短信签名】"
LIANLU_VERSION="1.2.0"
LIANLU_MESSAGE_TYPE="1"

# ---- 本站地址（生成短链/回调用）----
APP_BASE_URL="http://localhost:3000"

# ---- 发送限速（条/秒），按通道并发能力调整 ----
SEND_RATE_PER_SEC="20"

# ---- 默认租户（单租户兼容模式；正式 SaaS 后由登录 session 决定）----
DEFAULT_TENANT_ID="default_tenant"
DEFAULT_ACTOR="运营"

# ---- 发送合规与补偿策略 ----
FREQUENCY_DAYS="1"
REFUND_UNDELIVERED="false"

# ---- ROI 成本模型：每条短信单价（元/条，非法/负值回退 0.05；可设 0 表示免费通道）----
SMS_UNIT_COST="0.05"

# ---- 避扰时段（24h，跨午夜自动处理；默认 22:00-08:00 不发）----
QUIET_START="22"
QUIET_END="8"

# ---- 定时任务触发密钥（外部 cron 调 /api/cron/tick 时校验；生产环境 instrumentation 会强制要求配置）----
CRON_SECRET=""

# ---- 联麓 Webhook 签名密钥（delivery/mo 回调校验；生产环境 instrumentation 会强制要求配置）----
# 联麓控制台配置回调后下发的签名密钥；与联麓约定 HMAC-SHA256 over raw body，签名放 X-Lianlu-Signature 头
LIANLU_WEBHOOK_SECRET=""

# ---- 联麓端点/响应字段（⚠ 发送路径与响应结构以联麓发送 API 文档或联调为准）----
LIANLU_SEND_PATH="/sms/product/sendSMS"
LIANLU_BALANCE_PATH="/sms/product/balance"
# 以下路径联麓文档未确认，留空则对应功能自动降级（不调用）
LIANLU_MMS_PATH=""
LIANLU_FLASH_PATH=""
LIANLU_CHECK_PATH=""
LIANLU_QUERY_PATH=""
# 成功判定（默认 code=="0"）与消息/余额字段名（联调后按真实响应调整）
LIANLU_SUCCESS_FIELD="code"
LIANLU_SUCCESS_VALUE="0"
# 通道流水号字段：必须配置，否则发送成功拿不到 messageId → 回执无法关联 → 闭环断裂
LIANLU_MESSAGE_ID_FIELD=""
LIANLU_BALANCE_FIELD="balance"
LIANLU_TIMEOUT_MS="10000"

# ---- 联麓回执回调字段（按真实回执结构配置，默认按常见命名）----
LIANLU_DELIVERY_REPORTS_FIELD="reports"
LIANLU_DELIVERY_MESSAGE_ID_FIELD="messageId"
LIANLU_DELIVERY_EXTNO_FIELD="extno"
LIANLU_DELIVERY_MOBILE_FIELD="mobile"
LIANLU_DELIVERY_STATUS_FIELD="status"

# ---- A/B 自动放量：每个变体测试阶段最小样本量（达不到不判显著）----
AB_MIN_SAMPLE="30"

# ---- 登录认证 ----
# 多租户模式下登录走 AppUser 表（注册创建）；兼容模式：无 AppUser 时用 APP_PASSWORD 登录 default_tenant
APP_PASSWORD="admin"
AUTH_SECRET="change-me-to-a-long-random-string"
# 注册功能开关：false 暂停新租户注册（可设 true 默认开启）
REGISTER_ENABLED="true"
# 新租户注册赠送的初始短信额度（条）
REGISTER_SEED_GRANT="1000"
# seed 脚本创建默认管理员(admin@vcrm.local)的初始密码，生产请改
SEED_ADMIN_PASSWORD="admin"
